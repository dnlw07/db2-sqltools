{
  "name": "db2-sqltools",
  "displayName": "Db2 Driver for SQLTools",
  "description": "Db2 database integration with SQLTools extension for VSCode.",
  "version": "0.0.32",
  "engines": {
    "vscode": "^1.96.0"
  },
  "publisher": "lucashancock",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucashancock/db2-sqltools"
  },
  "bugs": {
    "url": "https://github.com/lucashancock/db2-sqltools/issues"
  },
  "icon": "icons/default.png",
  "galleryBanner": {
    "theme": "dark"
  },
  "pricing": "Free",
  "homepage": "https://github.com/lucashancock/db2-sqltools/blob/master/README.md",
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle",
    "compile": "tsc -p ./",
    "bundle:ext": "esbuild ./src/extension.ts --bundle --external:vscode --external:ibm_db --external:ssh2 --external:cpu-features --platform=node --tsconfig=./tsconfig.json --format=cjs --target=es2020 --minify --outfile=./out/extension.js",
    "bundle:ls": "esbuild ./src/ls/plugin.ts --bundle --external:vscode --external:ibm_db --external:ssh2 --external:cpu-features --platform=node --tsconfig=./tsconfig.json --format=cjs --target=es2020 --minify --outfile=./out/ls/plugin.js",
    "bundle": "npm run bundle:ext && npm run bundle:ls",
    "test": "npm run compile && node --test test",
    "watch": "tsc -watch -p ./",
    "pack:release": "vsce package"
  },
  "keywords": [
    "db2",
    "sqltools-driver"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Other"
  ],
  "extensionDependencies": [
    "mtxr.sqltools"
  ],
  "activationEvents": [
    "*",
    "onLanguage:sql",
    "onCommand:sqltools.*"
  ],
  "main": "./out/extension.js",
  "dependencies": {
    "@sqltools/base-driver": "latest",
    "@sqltools/types": "latest",
    "ibm_db": "^3.3.0",
    "uuid": "^7.0.2"
  },
  "devDependencies": {
    "@types/ibm_db": "^3.2.0",
    "@types/node": "^14.0.9",
    "@types/uuid": "^8.3.4",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.16.12",
    "typescript": "^5.7.2"
  }
}
